// AgentHub — Prisma schema
// Postgres + Prisma per project constraints. Categories are a strict enum.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum AgentCategory {
  REBALANCING
  GRID_TRADING
  YIELD_OPTIMIZATION
  HEALTH_FACTOR
}

// Distinguishes where a piece of data actually came from.
// This flag exists on every table that carries agent facts and MUST be
// surfaced in the UI. Never let DEMO data render indistinguishably from
// VERIFIED_ONCHAIN / VERIFIED_EXTERNAL data.
enum DataSource {
  VERIFIED_ONCHAIN     // read directly from BNB Smart Chain / ERC-8004 registry
  VERIFIED_EXTERNAL    // read from a trusted external API (e.g. 8004scan)
  MARKETPLACE_DERIVED  // computed by AgentHub from retrieved facts (e.g. trust score)
  SELF_REPORTED        // claimed by the agent's creator, not independently verified
  DEMO                 // seeded fixture data for hackathon demo purposes, not real
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum HireStatus {
  SIMULATED   // demo hire, no real transaction — Phase 6 default
  ONCHAIN     // real transaction (Altana session key), stretch goal only
}

model Agent {
  id                String        @id @default(cuid())
  name              String
  slug              String        @unique
  description       String
  category          AgentCategory
  capabilities      String[]
  supportedProtocols String[]
  supportedChains   String[]
  creator           String
  pricingModel      String        // human-readable, e.g. "$0.04 / execution"
  pricingSource     DataSource    @default(SELF_REPORTED)
  executionModel    String        // e.g. "autonomous, onchain execution every 15 min"
  status            String        @default("active") // active | inactive | new

  // ERC-8004 identity — nullable until verified via registry/8004scan
  erc8004Id         String?
  erc8004Verified   Boolean       @default(false)

  walletAddress     String?

  dataSource        DataSource    @default(DEMO)

  // Altana session-key hiring config. Null/false for every agent except
  // the small number actually wired to a real onchain flow -- see
  // ALTANA_INTEGRATION.md for which agents and why. Kept on Agent (not
  // hardcoded in route logic) so the hire page can render a real,
  // agent-specific permissions preview before the user approves anything.
  altanaEnabled              Boolean  @default(false)
  altanaAllowedContract      String?  // the single contract this agent's session is scoped to
  altanaContractLabel        String?  // human-readable label for the UI, e.g. "Venus Comptroller (testnet)"
  altanaSpendCapWei          String?  // stored as string -- Wei exceeds safe JS number range
  altanaSessionDurationSeconds Int?
  // 4-byte selector (hex, e.g. "0xf851a440") for the proof-of-pathway call
  // made through the session. Different allowed contracts need different
  // selectors -- a real, harmless, always-present view function on THAT
  // specific contract (see ALTANA_INTEGRATION.md for how each was picked
  // and verified). Falls back to Venus Unitroller's admin() selector if
  // unset, for backward compatibility with the original AgentCensus row.
  altanaProofSelector        String?

  metrics           AgentMetrics?
  trustScore        TrustScore?
  hires             Hire[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([category])
}

model AgentMetrics {
  id              String     @id @default(cuid())
  agent           Agent      @relation(fields: [agentId], references: [id])
  agentId         String     @unique

  executionsCount Int
  successRatePct  Float      // 0-100
  uptimePct       Float      // 0-100
  avgCostUsd      Float
  avgLatencySec   Float
  lastActiveAt    DateTime

  source          DataSource @default(DEMO)

  updatedAt       DateTime   @updatedAt
}

model TrustScore {
  id                    String     @id @default(cuid())
  agent                 Agent      @relation(fields: [agentId], references: [id])
  agentId               String     @unique

  score                 Int        // 0-100, deterministic — see lib/trust/engine.ts

  identityComponent     Int        // 0-20
  performanceComponent  Int        // 0-30
  reliabilityComponent  Int        // 0-25
  activityComponent     Int        // 0-15
  verificationComponent Int        // 0-10

  riskLevel             RiskLevel

  computedAt            DateTime   @default(now())
}

model Hire {
  id         String     @id @default(cuid())
  agent      Agent      @relation(fields: [agentId], references: [id])
  agentId    String

  status     HireStatus @default(SIMULATED)
  txHash     String?    // null unless status = ONCHAIN

  // Populated only when status = ONCHAIN, via the real Altana integration
  // (lib/altana/client.ts). Null for every SIMULATED hire.
  // NOTE: altanaSessionId actually stores the session's publicKey (a Hex
  // string) -- that's what Altana's SDK uses to identify a session for
  // revocation. Named altanaSessionId here for readability at the schema
  // level; don't be confused if you go looking for a separate "id" field
  // on the SDK's Session type -- there isn't one.
  altanaSessionId      String?
  altanaWalletAddress  String?
  spendCapWei          String?  // stored as string -- Wei values exceed safe JS number range
  sessionExpiresAt     DateTime?
  revokedAt            DateTime? // set when the user revokes the session in-product

  createdAt  DateTime   @default(now())
}
